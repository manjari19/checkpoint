# Copy to .env to override the development defaults used by docker-compose.yml.

# Secret key for hashing student card numbers. Use a long random value outside development,
# for example the output of: openssl rand -base64 32
# Changing it later makes every linked card stop matching, so members would need to re-link.
CARD_HASH_KEY=dev-only-card-hash-key-change-me

# The first organizer account, created on an empty database.
BOOTSTRAP_ADMIN_EMAIL=organizer@checkpoint.local
BOOTSTRAP_ADMIN_PASSWORD=checkpoint-demo

# Where the web app is served. Used to build the links in emails.
PUBLIC_BASE_URL=http://localhost:4300

# "demo" adds a separate demo club with a term of made-up history (login demo@checkpoint.local /
# checkpoint-demo). Leave it empty for real use; scripts/demo-data.sh remove deletes the demo club.
CHECKPOINT_PROFILES=demo
